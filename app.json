{
  "expo": {
    "name": "Faith Canvas",
    "slug": "faith-canvas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/faith-canvas/upload/apple/faith-canvas-app-store-icon-1024.png",
    "scheme": "faithcanvas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pidpod.faithcanvas",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pidpod.faithcanvas",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF8ED",
        "foregroundImage": "./assets/brand/faith-canvas/upload/android/faith-canvas-android-icon-source-1024.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/faith-canvas/upload/apple/faith-canvas-app-store-icon-1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Faith Canvas only asks for photo library access if you choose to save verse art or journal images to your device.",
          "savePhotosPermission": "Faith Canvas needs permission to save verse art and journal images to your photo library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9392c72-1d1e-48f7-a1c4-4916346afecc"
      }
    },
    "owner": "pidpoddev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/e9392c72-1d1e-48f7-a1c4-4916346afecc",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
